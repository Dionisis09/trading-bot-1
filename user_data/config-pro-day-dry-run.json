{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "pro-day-trader-v1-isolated-dry-run",
  "initial_state": "stopped",
  "strategy": "ProDayTraderV1",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "liquidation_buffer": 0.05,
  "max_open_trades": 2,
  "stake_currency": "USDT",
  "stake_amount": 100,
  "tradable_balance_ratio": 0.95,
  "fiat_display_currency": "EUR",
  "timeframe": "5m",
  "cancel_open_orders_on_exit": true,
  "force_entry_enable": false,
  "unfilledtimeout": {
    "entry": 5,
    "exit": 5,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true
    },
    "ccxt_async_config": {
      "enableRateLimit": true
    },
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "BNB/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "internals": {
    "process_throttle_secs": 5
  },
  "deployment_gate": {
    "required_decision": "APPROVE_SEPARATE_DRY_RUN",
    "current_status": "OFFLINE_NOT_DEPLOYED",
    "database": "sqlite:////freqtrade/user_data/tradesv3.pro-day-v1-dryrun.sqlite",
    "reserved_loopback_port": 8082,
    "live_trading_authorized": false
  }
}
